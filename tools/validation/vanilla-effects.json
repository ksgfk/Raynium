        "setblock 5 180 1 minecraft:shulker_box",
        "fill -1 179 -8 1 179 -6 minecraft:iron_block",
        "setblock 0 180 -7 minecraft:beacon",
        "summon minecraft:pig -3 180 -1 {NoAI:1b,NoGravity:1b,Silent:1b,Rotation:[0f,0f]}",
        "summon minecraft:sheep 0 180 -1 {NoAI:1b,NoGravity:1b,Silent:1b,Color:14b,Rotation:[0f,0f]}",
        "summon minecraft:armor_stand 3 180 -1 {NoGravity:1b,ShowArms:1b}",
        "give @s minecraft:diamond_sword",
        "give @s minecraft:diamond_pickaxe",
        "give @s minecraft:oak_planks",
        "give @s minecraft:enchanted_book",
        "give @s minecraft:filled_map",
        "give @s minecraft:shield",
        "give @s minecraft:apple",
        "give @s minecraft:bow",
        "data merge block -1 180 1 {front_text:{messages:[\"Raynium\",\"Text and fonts\",\"0123456789\",\"Unicode: 世界\"],color:\"black\",has_glowing_text:1b}}",
        "data merge block 1 180 1 {patterns:[{pattern:\"minecraft:stripe_center\",color:\"blue\"},{pattern:\"minecraft:cross\",color:\"red\"}]}",
        "item replace entity @e[type=minecraft:armor_stand,limit=1,sort=nearest] armor.head with minecraft:diamond_helmet[enchantments={protection:1}]",
        "item replace entity @e[type=minecraft:armor_stand,limit=1,sort=nearest] armor.chest with minecraft:diamond_chestplate[enchantments={protection:1}]",
        "item replace entity @e[type=minecraft:armor_stand,limit=1,sort=nearest] weapon.mainhand with minecraft:diamond_sword[enchantments={sharpness:1}]",
