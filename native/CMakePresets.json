{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-x64-msvc-staticcrt",
      "hidden": true,
      "generator": "Ninja",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded",
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "RADRAY_DEPENDENCY_TRIPLET": "windows-x64-msvc-staticcrt"
      }
    },
    {
      "name": "win-x64-debug",
      "inherits": "windows-x64-msvc-staticcrt",
      "binaryDir": "${sourceDir}/../build/native/windows-x64-msvc-staticcrt/Debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/../build/native/install/windows-x86_64/Debug"
      }
    },
    {
      "name": "win-x64-release",
      "inherits": "windows-x64-msvc-staticcrt",
      "binaryDir": "${sourceDir}/../build/native/windows-x64-msvc-staticcrt/Release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/../build/native/install/windows-x86_64/Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "win-x64-debug",
      "configurePreset": "win-x64-debug",
      "targets": ["rayniumruntime"]
    },
    {
      "name": "win-x64-release",
      "configurePreset": "win-x64-release",
      "targets": ["rayniumruntime"]
    }
  ]
}
